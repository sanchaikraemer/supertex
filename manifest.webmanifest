{
  "id": "./",
  "name": "Acompanhamento da Concreteira",
  "short_name": "Concreteira",
  "description": "Relatório das concretagens a partir da conversa do grupo do WhatsApp.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "arquivos",
          "accept": ["application/zip", "application/x-zip-compressed", "application/octet-stream", "text/plain", "audio/*", "image/*", "video/*", "*/*"]
        }
      ]
    }
  },
  "background_color": "#0f3d68",
  "theme_color": "#0b3258",
  "icons": [
    { "src": "icones/icone-azul-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icones/icone-azul-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icones/icone-azul-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
